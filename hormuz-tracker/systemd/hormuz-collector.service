[Unit]
Description=Hormuz ship tracker - AISStream forward collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/hatch/workspace/hormuz-tracker
ExecStart=/home/hatch/workspace/hormuz-tracker/run_collector.sh
Restart=always
RestartSec=15
StandardOutput=append:/home/hatch/workspace/hormuz-tracker/logs/systemd.log
StandardError=append:/home/hatch/workspace/hormuz-tracker/logs/systemd.log

[Install]
WantedBy=multi-user.target
